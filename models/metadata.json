{
  "model_name": "emotion_cnn",
  "model_version": "0.1.0",
  "model_file": "emotion_cnn.keras",
  "framework": "tensorflow.keras",
  "task": "facial_expression_recognition",
  "input": {
    "height": 48,
    "width": 48,
    "channels": 1,
    "color_mode": "grayscale",
    "normalization": "divide_by_255"
  },
  "num_classes": 5,
  "class_to_index": {
    "Angry": 0,
    "Happy": 1,
    "Sad": 2,
    "Surprise": 3,
    "Neutral": 4
  },
  "index_to_class": {
    "0": "Angry",
    "1": "Happy",
    "2": "Sad",
    "3": "Surprise",
    "4": "Neutral"
  },
  "training": {
    "dataset": "FER2013",
    "excluded_classes": ["disgust", "fear"],
    "notes": "Initial weights saved / training in progress. Will be updated upon final epoch."
  },
  "evaluation": {
    "test_accuracy": null,
    "notes": "Training in progress."
  },
  "disclaimer": "Classifies visible facial expressions. Does not determine internal emotional state."
}
